{
  "name": "dogfight-lab-04",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace client",
    "lint": "eslint client server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "experiment:backpressure": "node server/src/experiments/backpressure.js",
    "format": "prettier --write \"client/**/*.{js,css,html,json,md}\" \"server/**/*.js\" \"*.json\" README.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
